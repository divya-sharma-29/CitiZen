# ---- Civic AI Assistant (add to client/backend/.env) ----
# The assistant works WITHOUT these (deterministic answers + fallbacks).
# Set all three to enable AI answers for open-ended civic questions.
AI_PROVIDER=anthropic          # anthropic | openai (openai also works with OpenAI-compatible servers)
AI_API_KEY=your-provider-key   # server-side only; never put this in frontend code
AI_MODEL=your-model-name       # required; check your provider's current model list
# AI_BASE_URL=                 # optional override of the provider URL
# AI_TIMEOUT_MS=15000
# AI_MAX_TOKENS=600

# Limits and retention (all optional; defaults shown)
# AI_RATE_LIMIT_PER_MIN=20
# AI_RATE_LIMIT_PER_HOUR=200
# AI_RATE_LIMIT_IP_PER_MIN=120
# AI_HISTORY_MAX_MESSAGES=100
# AI_HISTORY_RETENTION_DAYS=30
